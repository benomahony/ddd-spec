{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benomahony.github.io/ddd-spec/v0.1/ddd.schema.json",
  "title": "ddd-spec",
  "description": "A ddd.yaml manifest, or a context file it lists.",
  "if": { "type": "object", "required": ["contexts"] },
  "then": { "$ref": "#/$defs/manifest" },
  "else": { "$ref": "#/$defs/context" },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "manifest_id": {
      "description": "A name for the manifest that is unique across every repository, such as acme.events.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "context_ref": {
      "description": "A context in this manifest by its name, or in another manifest as <manifest id>/<name>.",
      "type": "string",
      "pattern": "^([a-z0-9][a-z0-9.-]*/)?[a-z0-9][a-z0-9-]*$"
    },
    "term_ref": {
      "description": "A term in another context's language, as <context>#<term>.",
      "type": "string",
      "pattern": "^([a-z0-9][a-z0-9.-]*/)?[a-z0-9][a-z0-9-]*#.+$"
    },
    "code_ref": {
      "description": "A file relative to the repository root, using /, optionally followed by #Symbol.",
      "type": "string",
      "pattern": "^[^#\\s/][^#\\s]*(#[A-Za-z_][A-Za-z0-9_.]*)?$"
    },
    "code_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/code_ref" },
      "uniqueItems": true
    },
    "contract_name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*$"
    },
    "sentence": {
      "type": "string",
      "minLength": 1
    },
    "sentences": {
      "type": "array",
      "items": { "$ref": "#/$defs/sentence" }
    },
    "status": {
      "description": "Whether the model describes a plan, the code as it is, or something being removed. Implemented is the author's claim; the linked code and tests are its evidence.",
      "enum": ["proposed", "implemented", "deprecated"]
    },
    "extensions": {
      "patternProperties": {
        "^x-": {}
      }
    },
    "manifest": {
      "type": "object",
      "required": ["ddd_spec_version", "id", "contexts"],
      "allOf": [{ "$ref": "#/$defs/extensions" }],
      "unevaluatedProperties": false,
      "properties": {
        "ddd_spec_version": {
          "description": "The version of ddd-spec the manifest follows.",
          "const": "0.1"
        },
        "id": { "$ref": "#/$defs/manifest_id" },
        "name": { "type": "string" },
        "contexts": {
          "description": "Each bounded context, by name: a context file relative to this one, or the context itself.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": {
            "if": { "type": "string" },
            "then": { "pattern": "^[^\\s/][^\\s]*\\.ya?ml$" },
            "else": { "$ref": "#/$defs/context" }
          }
        }
      }
    },
    "context": {
      "type": "object",
      "required": ["purpose"],
      "allOf": [{ "$ref": "#/$defs/extensions" }],
      "unevaluatedProperties": false,
      "properties": {
        "name": { "type": "string" },
        "purpose": {
          "description": "The business responsibility of the context.",
          "$ref": "#/$defs/sentence"
        },
        "owner": {
          "description": "The team accountable for the context.",
          "type": "string"
        },
        "classification": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "domain": { "enum": ["core", "supporting", "generic"] }
          }
        },
        "scope": {
          "description": "What belongs in this context, and what belongs elsewhere.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "includes": { "$ref": "#/$defs/sentences" },
            "excludes": { "$ref": "#/$defs/sentences" }
          }
        },
        "code": {
          "description": "Globs, relative to the repository root, for the files that implement the context.",
          "type": "array",
          "items": { "type": "string", "pattern": "^[^\\s/][^\\s]*$" },
          "uniqueItems": true
        },
        "language": {
          "description": "Each term the context uses, with what it means here.",
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/term" }
        },
        "aggregates": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": { "$ref": "#/$defs/aggregate" }
        },
        "invariants": {
          "description": "Rules every change must preserve.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": { "$ref": "#/$defs/invariant" }
        },
        "provides": {
          "description": "The contracts the context owns: commands and queries it accepts, and events it emits.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/contract_name" },
          "additionalProperties": { "$ref": "#/$defs/contract" }
        },
        "uses": {
          "description": "Each context whose model this one depends on, and how it treats that model.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/context_ref" },
          "additionalProperties": { "$ref": "#/$defs/use" }
        },
        "customers": {
          "description": "Contexts whose needs this one plans for.",
          "type": "array",
          "items": { "$ref": "#/$defs/context_ref" },
          "uniqueItems": true
        },
        "partners": {
          "description": "Contexts this one succeeds or fails with, and plans together with.",
          "type": "array",
          "items": { "$ref": "#/$defs/context_ref" },
          "uniqueItems": true
        }
      }
    },
    "term": {
      "if": { "type": "string" },
      "then": { "$ref": "#/$defs/sentence" },
      "else": {
        "type": "object",
        "required": ["means"],
        "additionalProperties": false,
        "properties": {
          "means": { "$ref": "#/$defs/sentence" },
          "not": {
            "description": "Words that must not stand in for this term inside this context.",
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "from": {
            "description": "The term in another context this one is translated from.",
            "$ref": "#/$defs/term_ref"
          },
          "code": { "$ref": "#/$defs/code_refs" }
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": { "$ref": "#/$defs/sentence" },
        "root": { "$ref": "#/$defs/code_ref" },
        "status": { "$ref": "#/$defs/status" }
      }
    },
    "invariant": {
      "type": "object",
      "required": ["statement", "status"],
      "additionalProperties": false,
      "properties": {
        "statement": { "$ref": "#/$defs/sentence" },
        "status": { "$ref": "#/$defs/status" },
        "applies_to": {
          "description": "The aggregates whose consistency boundary holds the rule, once that is decided.",
          "type": "array",
          "items": { "$ref": "#/$defs/name" },
          "uniqueItems": true
        },
        "enforced_by": { "$ref": "#/$defs/code_refs" },
        "verified_by": { "$ref": "#/$defs/code_refs" }
      }
    },
    "contract": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["command", "query", "event"] },
        "means": { "$ref": "#/$defs/sentence" },
        "published": {
          "description": "The contract is versioned, and other contexts may rely on it.",
          "type": "boolean"
        },
        "status": { "$ref": "#/$defs/status" },
        "defined_in": {
          "description": "Where its format is defined, such as an AsyncAPI or OpenAPI document.",
          "type": "string",
          "format": "uri-reference"
        }
      }
    },
    "use": {
      "type": "object",
      "required": ["model"],
      "additionalProperties": false,
      "properties": {
        "model": {
          "description": "Whether this context adopts the other's model, translates it into its own, or shares its code.",
          "enum": ["conform", "translate", "share"]
        },
        "contracts": {
          "type": "array",
          "items": { "$ref": "#/$defs/contract_name" },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "if": { "properties": { "model": { "enum": ["conform", "translate"] } } },
      "then": { "required": ["contracts"] }
    }
  }
}
