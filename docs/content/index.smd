.title = "ddd-spec",
.description = "A domain model that lives next to the code: which bounded contexts a repository holds, what their words mean, which rules every change must preserve, and how the contexts depend on each other. People, coding agents and tools all read the same files.",
.date = .date("2026-10-20T00:00:06"),
